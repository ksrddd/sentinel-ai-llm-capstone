# Copy to .env (git-ignored) and fill in the class proxy values. Never commit .env.
OPENAI_API_KEY=replace-with-your-class-proxy-key
OPENAI_BASE_URL=https://replace-with-class-proxy-host/v1

# Required class model (do not change for the graded application)
SENTINEL_MODEL=gemma-4-E4B-it
SENTINEL_TEMPERATURE=0

# Agent
SENTINEL_AGENT_TOOL_MODE=auto        # auto | native | json
SENTINEL_AGENT_MAX_STEPS=6
SENTINEL_AGENT_TIMEOUT_S=150
SENTINEL_LLM_TIMEOUT_S=60

# Retrieval (defaults = configuration selected on the dev split; see eval/results/selected_config.json)
# SENTINEL_RETRIEVER=hybrid           # bm25 | dense | hybrid
# SENTINEL_DENSE_BACKEND=sbert        # sbert | lsa
# SENTINEL_CHUNKING=section           # section | fixed
# SENTINEL_HYBRID_ALPHA=0.3
# SENTINEL_MIN_SCORE=0.316955
# SENTINEL_DB_PATH=data/sentinel.db
